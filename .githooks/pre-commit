#!/bin/sh
# OpenCodeReview — delegation mode pre-commit hook.
#
# OCR (ocr delegate) chọn file + resolve rule; OpenCode (`opencode run`) thực
# hiện review bằng model của chính nó. KHÔNG cần LLM API key phía OCR.
#
# Hook chỉ CẢNH BÁO, không chặn commit — bạn tự quyết định dựa trên output.
# Tắt tạm: OCR_REVIEW=0 git commit ...
#
# Cài đặt (bắt buộc, fresh clone không tự có):
#   git config core.hooksPath .githooks

if [ "$OCR_REVIEW" = "1" ]; then :; else
  case "$OCR_REVIEW" in
    0|false|no|off|"") ;;
    *) echo "ocr: skipped (OCR_REVIEW=$OCR_REVIEW)"; exit 0 ;;
  esac
fi

if ! command -v ocr >/dev/null 2>&1; then
  echo "ocr: REVIEW DID NOT RUN — CLI not found (npm i -g @alibaba-group/open-code-review)"
  exit 0
fi

if ! command -v opencode >/dev/null 2>&1; then
  echo "ocr: REVIEW DID NOT RUN — opencode CLI not found"
  exit 0
fi

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$STAGED" ]; then
  exit 0
fi

echo "ocr: reviewing ${STAGED} ..." >&2

# --agent plan = read-only (không có write/bash edit), nên agent không thể sửa
# file dù prompt có yêu cầu. Không dùng --auto.
opencode run --agent plan "Review ONLY these staged files: ${STAGED}.

Load the open-code-review-delegate skill, run 'ocr delegate rule --format json <those paths>'
to get the review rules, then read the staged diff of each file (git diff --cached --
<path>) and report findings as path / line / severity / category. Ignore uncommitted
unstaged changes and untracked files — they are not part of this commit.

Apply this repo's rules from AGENTS.md and .agents/rules/: no imputation in
deterministic cleaning, no preprocessing before the chronological split,
time-series safety, and statistical results need p-value + effect size + CI." \
  || echo "ocr: REVIEW FAILED (network/provider/model) — commit proceeds unreviewed." >&2

exit 0