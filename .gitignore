# ============================================================
# .gitignore – Air Pollution Analysis (INFO3020)
# ============================================================

# ── Python bytecode & caches ─────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── Virtual environments ─────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Jupyter Notebook checkpoints ─────────────────────────────
.ipynb_checkpoints/

# ── Environment variables & credentials ──────────────────────
.env
.env.*
*.pem
*.key

# ── Test runner caches ────────────────────────────────────────
.pytest_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# ── Raw data (immutable, fetched via API – do NOT commit) ────
data/raw/*.json
data/raw/*.csv
data/raw/*.parquet
!data/raw/.gitkeep
!data/raw/metadata.json

# ── Generated reports (sinh lại bằng script, không track) ──
# scripts/verify_claims.py mặc định ghi reports/claim_audit.csv — chạy lại
# được bất cứ lúc nào, không phải trạng thái cần bàn giao.
reports/*
!reports/.gitkeep
!reports/statistical_profile.csv
# reports/inference_results.md là deliverable của Issue #11 (W9): báo cáo
# kiểm định giả thuyết được đối chiếu trực tiếp với notebook 05 khi chấm,
# nên phải nằm trong Git dù toàn bộ reports/ còn lại là output sinh lại.
!reports/inference_results.md
# reports/regression_results.md là deliverable của Issue #12 (W10): báo cáo
# hồi quy OLS và chẩn đoán LINE được đối chiếu trực tiếp khi chấm.
!reports/regression_results.md
# reports/inference_montecarlo.csv là bằng chứng kiểm chứng Monte Carlo của
# Issue #11 (W9): nó cho phép người đọc kiểm tra tỷ lệ bác bỏ H0 mà không cần
# chạy lại mô phỏng (vài chục phút). Sinh lại bằng
# `python scripts/validate_inference_montecarlo.py --n-sim 1000`.
!reports/inference_montecarlo.csv
# Báo cáo kết quả và biên bản kiểm toán rò rỉ dữ liệu Issue #13:
!reports/classification_results.md
!reports/classification_leakage_audit.md

# ⚠️ figures/ CỐ Ý KHÔNG bị ignore: FIG-01…FIG-07 là bằng chứng chấm điểm
# (mục "biểu đồ ấn phẩm" 20% rubric) và hội đồng cần mở repo xem được.
# Xem task D28 trong docs/TASK_LIST_M3_M6.md.

# ── Large / generated data files ─────────────────────────────
data/interim/*.parquet
data/interim/*.csv
!data/interim/.gitkeep
data/processed/*.parquet
data/processed/*.csv
!data/processed/.gitkeep

# ── IDE & OS artifacts ───────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── OpenCode agent runtime ────────────────────────────────────
# Agent definitions, slash command, skills và tool config đều là trạng
# thái cục bộ, không thuộc phạm vi bàn giao học thuật.
.opencode/


# ── Build / dist ─────────────────────────────────────────────
*.egg-info/
dist/
build/
!reports/issue44_mirror_manifest.json
!reports/issue44_openaq_poc.json
!reports/issue44_openaq_7441_manifest.json
!reports/issue44_extended_dataset_metadata.json
!reports/issue44_interpolation_evaluation.csv
!reports/issue44_multiyear_eda_summary.csv
!reports/issue44_legacy_vs_extended_comparison.md
