# ============================================================
# .gitignore – Air Pollution Analysis (INFO3020)
# ============================================================

# ── Python bytecode & caches ─────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── Virtual environments ─────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Jupyter Notebook checkpoints ─────────────────────────────
.ipynb_checkpoints/

# ── Environment variables & credentials ──────────────────────
.env
.env.*
*.pem
*.key

# ── Test runner caches ────────────────────────────────────────
.pytest_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# ── Raw data (immutable, fetched via API – do NOT commit) ────
data/raw/*.json
data/raw/*.csv
data/raw/*.parquet
!data/raw/.gitkeep
!data/raw/metadata.json

# ── Large / generated data files ─────────────────────────────
data/interim/*.parquet
data/interim/*.csv
!data/interim/.gitkeep
data/processed/*.parquet
data/processed/*.csv
!data/processed/.gitkeep

# ── IDE & OS artifacts ───────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── OpenCode agent runtime ────────────────────────────────────
# Agent definitions, slash command, skills và tool config đều là trạng
# thái cục bộ, không thuộc phạm vi bàn giao học thuật.
.opencode/


# ── Build / dist ─────────────────────────────────────────────
*.egg-info/
dist/
build/
