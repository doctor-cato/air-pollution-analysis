# ============================================================
# .gitignore – Air Pollution Analysis (INFO3020)
# ============================================================

# ── Python bytecode & caches ─────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── Virtual environments ─────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Jupyter Notebook checkpoints ─────────────────────────────
.ipynb_checkpoints/

# ── Environment variables & credentials ──────────────────────
.env
.env.*
*.pem
*.key

# ── Test runner caches ────────────────────────────────────────
.pytest_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# ── Raw data (immutable, fetched via API – do NOT commit) ────
data/raw/*.json
data/raw/*.csv
data/raw/*.parquet
!data/raw/.gitkeep
!data/raw/metadata.json

# ── Large / generated data files ─────────────────────────────
data/interim/*.parquet
data/interim/*.csv
!data/interim/.gitkeep
data/processed/*.parquet
data/processed/*.csv
!data/processed/.gitkeep

# ── IDE & OS artifacts ───────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── OpenCode agent runtime ────────────────────────────────────
# .opencode/agents/*.md và .opencode/opencode.json là cấu hình/runtime
# cục bộ của OpenCode, không thuộc phạm vi bàn giao học thuật.
# Lưu ý: .opencode/command/ocr-review.md và
# .opencode/skills/open-code-review-delegate/SKILL.md ĐÃ được track từ
# commit f9a17bc — .gitignore KHÔNG gỡ track file đã track.
.opencode/


# ── Build / dist ─────────────────────────────────────────────
*.egg-info/
dist/
build/
